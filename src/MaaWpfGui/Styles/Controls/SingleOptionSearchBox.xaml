<!--
单选项搜索选择器：输入即过滤 + 可选中 + 失焦/回车/▼提交。
行为规格见 work-docs/设计文档/单选项搜索选择器-交互与状态机设计.md。
-->

<UserControl
    x:Class="MaaWpfGui.Styles.Controls.SingleOptionSearchBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:helper="clr-namespace:MaaWpfGui.Helper"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignWidth="220"
    mc:Ignorable="d">
    <UserControl.Resources>
        <!-- 错误色（红），避免依赖外部 DangerBrush -->
        <SolidColorBrush x:Key="SearchBoxErrorBrush" Color="#E64545" />
        <!-- 下拉箭头（对齐 HandyControl ComboBox 的 DownGeometry/UpGeometry） -->
        <Geometry x:Key="SearchBoxDownGeometry">M512 801.6896L5.12 282.0096l58.1632-59.5968L512 682.3936l448.7168-460.0832 58.1632 59.5968-506.88 519.7824z</Geometry>
        <Geometry x:Key="SearchBoxUpGeometry">M50.000001,0 L100,51.262779 94.262627,57.141584 50.000001,11.767713 5.7373757,57.151686 0,51.27288 z</Geometry>
        <!-- 裸 ToggleButton：模板即纯 ContentPresenter，无默认边框/hover 视觉（避免圆角灰色线包裹） -->
        <Style x:Key="SearchBoxToggleButtonStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 输入框 + 水印 + 框内按钮 -->
        <Border
            x:Name="BoxBorder"
            Grid.Row="0"
            Height="28"
            Background="{DynamicResource RegionBrushOpacity25}"
            BorderThickness="1"
            CornerRadius="4">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                    <Style.Triggers>
                        <!-- 悬停灰 / 聚焦(输入态)蓝，对齐 HandyControl ComboBox -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource SecondaryBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <TextBox
                    x:Name="InputTextBox"
                    Padding="8,0,30,0"
                    Background="Transparent"
                    BorderThickness="0"
                    CaretBrush="{DynamicResource PrimaryTextBrush}"
                    Foreground="{DynamicResource PrimaryTextBrush}"
                    hc:InfoElement.MinContentHeight="0"
                    VerticalAlignment="Center"
                    GotKeyboardFocus="OnTextBoxGotKeyboardFocus"
                    LostKeyboardFocus="OnTextBoxLostKeyboardFocus"
                    PreviewKeyDown="OnTextBoxPreviewKeyDown"
                    Style="{StaticResource MaaTextBoxDefaultStyle}"
                    TextChanged="OnTextBoxTextChanged" />
                <TextBlock
                    x:Name="WatermarkTextBlock"
                    Margin="8,0,30,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource ThirdlyTextBrush}"
                    IsHitTestVisible="False"
                    Text="{Binding Placeholder, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Visibility="Collapsed" />
                <ToggleButton
                    x:Name="ToggleButton"
                    Width="28"
                    HorizontalAlignment="Right"
                    Click="OnToggleButtonClick"
                    Cursor="Hand"
                    Style="{StaticResource SearchBoxToggleButtonStyle}">
                    <Path
                        x:Name="TogglePath"
                        Width="14"
                        Margin="0,0,1,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Data="{StaticResource SearchBoxDownGeometry}"
                        Fill="{Binding BorderBrush, ElementName=BoxBorder}"
                        Stretch="Uniform" />
                </ToggleButton>
            </Grid>
        </Border>

        <!-- 内联错误提示 -->
        <TextBlock
            x:Name="ErrorHintTextBlock"
            Grid.Row="1"
            Margin="8,2,0,0"
            Foreground="{DynamicResource SearchBoxErrorBrush}"
            Text="{Binding ErrorText, RelativeSource={RelativeSource AncestorType=UserControl}}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />

        <!-- 下拉浮层 -->
        <Popup
            x:Name="DropdownPopup"
            Width="{Binding ActualWidth, ElementName=BoxBorder}"
            AllowsTransparency="True"
            helper:MouseWheelHelper.IsolateParentScroll="True"
            Placement="Bottom"
            PlacementTarget="{Binding ElementName=BoxBorder}"
            StaysOpen="True">
            <Border
                Background="{DynamicResource RegionBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <Grid>
                    <ListBox
                        x:Name="ResultsListBox"
                        MaxHeight="300"
                        Background="Transparent"
                        BorderThickness="0"
                        DisplayMemberPath="Name"
                        Focusable="False"
                        PreviewMouseLeftButtonUp="OnResultsListBoxPreviewMouseLeftButtonUp"
                        ScrollViewer.CanContentScroll="True"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style
                                BasedOn="{StaticResource TransparentListBoxItemStyle}"
                                TargetType="{x:Type ListBoxItem}">
                                <!-- 项不可聚焦：点击项不夺走输入框键盘焦点，避免误触发失焦提交 -->
                                <Setter Property="Focusable" Value="False" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <TextBlock
                        x:Name="EmptyResultTextBlock"
                        Margin="8,6"
                        Foreground="{DynamicResource ThirdlyTextBrush}"
                        Text="{Binding ErrorText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Visibility="Collapsed" />
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
